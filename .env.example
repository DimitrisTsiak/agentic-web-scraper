# Environment Variables for Web Scraper Agent

# Google Gemini API Key for AI-Powered Extractor
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Custom User Agent
CUSTOM_USER_AGENT=WebScraperAgent/1.0

# Optional: Allowed CORS Origins (comma-separated or '*' for public access)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

